+static void refresh_memory_maps() {
+    static std::size_t areas = 0;
+    auto process = Core::System::GetInstance().Kernel().GetCurrentProcess();
+    if (!process)
+        return;
+    const std::size_t now = process->vm_manager.vma_map.size();
+    if (now != areas) {
+        areas = now;
+        setup_memory_maps();
+    }
+}
+
+// yomikata: the FCRAM whole as the system RAM (as the older Citra core gives it), for a frontend that reads a
+// game's memory as one block: the linear heap is it, page for page, from its start (0x14000000).
 void* retro_get_memory_data(unsigned id) {
